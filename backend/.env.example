# ---------- core ----------
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/examai

# Only for local development with no SMS/email provider configured — echoes
# the live OTP back in register/forgot-password/login-otp responses. Requires
# NODE_ENV != production too. Never set this on anything reachable by anyone
# other than you.
DEV_OTP_ECHO=false

# How many proxies stand in front of the app: 1 for Caddy alone or a load
# balancer straight to the app, 2 for a load balancer in front of Caddy.
TRUST_PROXY=1

# Load tests only (loadtest/GUIDE.txt): requests with this value in the
# X-Loadtest-Token header skip rate limits, and scripts/loadtest.js runs.
# 32+ characters. Leave empty; remove it again when the test is over.
LOADTEST_TOKEN=

# 32+ random bytes. generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# used to encrypt provider api keys at rest. 32 bytes hex (64 chars)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---------- clients ----------
# when SERVE_STATIC=true the backend serves both builds and these are unused
# (search tags, sitemap and robots.txt then use the address the site is
# reached at, or Settings → SEO → Canonical URL)
SERVE_STATIC=true
CLIENT_URL_ADMIN=http://localhost:5173
CLIENT_URL_STUDENT=http://localhost:5174

# The Capacitor-wrapped native app (mobile-app/) only — leave unset unless
# you're building that. Its webview is never same-origin with this API
# regardless of SERVE_STATIC, so it needs its own CORS allowlist entry.
# Comma-separated; Capacitor's own default webview origins are
# "https://localhost" (Android) and "capacitor://localhost" (iOS) unless
# mobile-app/capacitor.config.json overrides androidScheme/iosScheme.
# The app signs in with a token in a header, not the cookie (iOS drops
# cross-site cookies), so COOKIE_SAMESITE can stay strict. The API must be
# on HTTPS.
# CLIENT_URL_MOBILE=https://localhost,capacitor://localhost

# Public URL of this API, as reachable from the internet. Only needed by
# gateways that push their result to a listener URL you register at checkout
# time rather than one configured in their dashboard — SSLCommerz sends its
# IPN to ipn_url, which is built from this. Leaving it unset means SSLCommerz
# payments complete without ever granting access.
SERVER_URL=http://localhost:5000

# Payment gateways are configured from the admin panel (Settings > Payment
# gateways) and stored encrypted. Setting a credential here instead makes it
# authoritative and read-only in that screen — the environment always wins.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_SANDBOX=true
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_SANDBOX=true
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_SANDBOX=true

# ---------- cookies ----------
# leave COOKIE_DOMAIN blank for single-origin installs (SERVE_STATIC=true).
# set to .example.com only when admin/app/api are on different subdomains,
# and then COOKIE_SAMESITE must be 'none'.
COOKIE_DOMAIN=
COOKIE_SAMESITE=strict

# ---------- adapters ----------
# sms: leave blank to not offer phone signup yet. twilio | vonage | http
SMS_PROVIDER=
# storage: local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# Hosted video (optional). Bunny Stream: expiring, domain-locked links.
BUNNY_LIBRARY_ID=
BUNNY_SECURITY_KEY=
# Optional: the library's API key (Stream > API), for uploading saved AI
# videos to Bunny. Unset: BUNNY_SECURITY_KEY is used.
BUNNY_API_KEY=
# Optional: a Vimeo app token with the upload scope, for uploading saved AI
# videos to Vimeo. Linking existing Vimeo videos needs nothing.
VIMEO_ACCESS_TOKEN=
# VdoCipher: real DRM (Widevine/FairPlay) with each viewer's name drawn over
# the video. API secret from the VdoCipher dashboard > Config > API keys.
# AI videos saved as a question's or lecture's video can go to VdoCipher,
# Bunny or Vimeo (chosen when saving; VdoCipher first when it's set up).
VDOCIPHER_API_SECRET=
# Payment gateways are no longer selected here. Several can be live at once,
# each restricted to the currencies it should take, configured from the admin
# panel under Settings > Payment gateways. See the SERVER_URL block above for
# the credential variables, which remain optional and override the panel.
# queue: memory | redis
QUEUE_DRIVER=memory
REDIS_URL=

# ---------- email (student OTP + notifications) ----------
# independent of SMS_PROVIDER — set these and email signup works even with
# no SMS gateway configured at all.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=trj.buet@gmail.com
SMTP_PASS=<16-char app password from myaccount.google.com/apppasswords>
SMTP_FROM=trj.buet@gmail.com

# ---------- optional: sms gateways (only the one SMS_PROVIDER selects) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=

# a generic gateway for anything not listed above — posts {to, message} as
# json to this url. Add SMS_HTTP_AUTH_HEADER if it needs one.
SMS_HTTP_URL=
SMS_HTTP_AUTH_HEADER=


# ---------------------------------------------------------------- LiveKit
# The in-app classroom and webinars (live class provider "LiveKit").
# A self-hosted LiveKit server: LIVEKIT_URL is the address browsers connect
# to (wss:// in production). For a quick local test run
#   livekit-server --dev            (key "devkey", secret "secret")
# and use ws://localhost:7880. See LIVEKIT_SETUP.md.
# LIVEKIT_URL=wss://live.example.com
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Where the Egress container writes recordings when STORAGE_PROVIDER=local
# (mount backend/uploads/recordings there). Default /out.
# LIVEKIT_EGRESS_DIR=/out

# Coding questions: the sandbox that runs students' code. judge0 | piston
CODE_RUNNER=judge0
# Piston (self-hosted, one Docker container), e.g. http://localhost:2000
PISTON_URL=
# Judge0
# Self-hosted (Docker) e.g. http://localhost:2358, or a hosted plan's URL.
JUDGE0_URL=
# Optional. Sent as X-Auth-Token (or X-RapidAPI-Key for a RapidAPI URL).
JUDGE0_KEY=
