# The sales demo's settings (deploy/docker-compose.demo.yml reads them from
# deploy/demo.env). Never reuse the live product's secrets here.

NODE_ENV=production
PORT=5000
SERVE_STATIC=true

# Run locally without Docker: a MongoDB on this machine only.
# MONGO_URI=mongodb://127.0.0.1:27017/examai_demo
DEMO_MODE=1

# Make each one fresh: openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=

# The one password the browser asks for before anything loads. Give it to
# the sales team; change it when someone leaves.
DEMO_BASIC_USER=sales
DEMO_BASIC_PASSWORD=

# The demo owner account (owner@example.com). Every other demo account
# (teachers, graders, students…) uses 123456789.
DEMO_OWNER_PASSWORD=

# Where the saved reset state goes (node demo/snapshot.js save). Default:
# backend/demo/snapshot. Keep it outside the uploads folder.
# DEMO_SNAPSHOT_PATH=

# How many records of each kind the lists get after a reset.
DEMO_FILL_COUNT=40

# The address the demo is served on, e.g. https://demo.example.com
SERVER_URL=
CLIENT_URL_ADMIN=
CLIENT_URL_STUDENT=

# Built-in AI model: context window in tokens (more needs more RAM).
# EMBEDDED_CONTEXT=16384

# AI: set the main connection, picture AI and voice in the admin panel
# (Settings → AI) after each reset, or keep them in the demo's own keys.
# Leave SMTP_* and SMS keys out: the demo sends no email or SMS.
